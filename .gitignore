__pycache__/
*.pyc
.pytest_cache/
sim_results.csv
scaling_results.csv
ld_scaling_results.csv

# OS / editor cruft
.DS_Store
*.Rhistory
.idea/
.vscode/

# Python build / packaging artifacts
*.egg-info/
build/
dist/

# Ephemeral test-dependency staging (created by the codex test harness)
.codex-test-deps/

# Numba JIT cache
*.nbc
*.nbi

# Cached figure data (machine-specific timings; regenerated by make_paper_figures.py)
benchmarks/figdata_*.csv

# Per-benchmark PNGs are regenerated by their producer scripts (savefig) and
# re-plotted into figures.pdf.
benchmarks/*.png
benchmarks/figures.pdf

# Coalescent LD library + on-disk LD cache sidecars (large, regenerated locally)
ld_library.npz
*.npz.dat.npy

# Benchmark msprime pool cache (regenerated on demand; keyed by #SNPs)
benchmarks/.ld_cache/

# Durable chromosome shards for the genome-wide D8/LR8 scaling benchmark
benchmarks/*.csv.work/

# Per-run benchmark logs and machine-local timing summaries
benchmarks/.runs/
benchmarks/*.log

# Benchmark scratch work dirs (repo root and benchmarks/ both used)
/.work/
benchmarks/.work/

# Real-data benchmark inputs: PGS Catalog scoring files and LD references are
# large, externally versioned artifacts. Benchmarks take them via --flags and
# record their sha256 in provenance; they are never part of the repository.
benchmarks/.scores*/
benchmarks/.ldref*/
